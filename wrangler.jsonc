{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "projectspg",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-14",
  "routes": [
    { "pattern": "projectspg.info/*", "zone_name": "projectspg.info" },
    { "pattern": "www.projectspg.info/*", "zone_name": "projectspg.info" },
    { "pattern": "api.projectspg.info", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "privacy-db",
      "database_id": "3c044753-b439-410a-b47b-69fd529acec3"
    }
  ]
}
